# ── MMC Core production settings ── copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 32

# Public address people open. Local test: http://localhost:8090 · VPS: https://mmc.example.com
PUBLIC_URL=http://localhost:8090
# Caddy site address. Local: ":80" · VPS: the bare domain, e.g. "mmc.example.com" (enables HTTPS)
SITE_ADDRESS=:80
HTTP_PORT=8090
HTTPS_PORT=8453

# First owner account (invited by the seed; activate it at /login → «فعّل حسابك»)
OWNER_EMAIL=owner@example.com

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
BETTER_AUTH_SECRET=
PAYMENTS_WEBHOOK_SECRET=

# Sandbox payment/e-sign pages for testing ONLY on this PC. Keep false on the public VPS.
ALLOW_SANDBOX=false

# Optional: require TOTP/passkey for owner/general manager/accountant
MFA_ENFORCE=false
ALLOWED_EMAIL_DOMAINS=

# Integrations — leave empty for sandbox mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
LEADS_WEBHOOK_SECRET=
ESIGN_PROVIDER=sandbox
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=
PAYMENTS_PROVIDER=sandbox
PAYMENTS_SECRET_KEY=
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=
ERPNEXT_WEBHOOK_SECRET=

# Image names/tag (set by mmc.sh)
IMAGE_PREFIX=mmc
IMAGE_TAG=latest
