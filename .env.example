# Copy to .env (never commit .env). Values here are local-development defaults only.
# Migrations / admin connection (owner role)
DATABASE_ADMIN_URL=postgres://mmc:mmc_dev_only@localhost:5433/mmc
# Runtime connection — non-owner role so row-level security applies
DATABASE_URL=postgres://mmc_app:mmc_app_dev_only@localhost:5433/mmc
APP_DB_PASSWORD=mmc_app_dev_only

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-32-chars-minimum-dev-only-secret
# Google sign-in (OAuth client "Web application"; origin http://localhost:3000)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict Google sign-in to these e-mail domains (comma-separated; empty = invitation list only)
ALLOWED_EMAIL_DOMAINS=

GOTENBERG_URL=http://localhost:3300
FILES_DIR=./.data/files

# Messaging — leave empty to use the sandbox adapters (messages are logged, not sent)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SMTP_URL=

# E-signature provider (Nafath-backed TSP) — empty = sandbox
ESIGN_PROVIDER=sandbox
ESIGN_API_KEY=

# Back office — empty = in-process fake ERP (for development and tests)
# 32-byte key (base64 or 64 hex chars) that seals the EGS private key and ZATCA CSIDs at rest (Phase 6D).
# Required in production for e-invoicing; generate with: openssl rand -base64 32
EINVOICE_KEY=

ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_WEBHOOK_SECRET=

# Payment gateway — empty = sandbox
PAYMENTS_PROVIDER=sandbox
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Lead-ads intake (Meta/Snapchat/TikTok via connector): HMAC secret for /api/webhooks/leads/:source
LEADS_WEBHOOK_SECRET=

# ThingsBoard (Phase 7c IoT): HMAC secret for /api/iot/thingsboard/{webhook,heartbeat} (header X-MMC-Signature);
# URL + tenant user for alarm ack/clear — leave empty for the sandbox (logged only)
THINGSBOARD_WEBHOOK_SECRET=
THINGSBOARD_URL=
THINGSBOARD_USERNAME=
THINGSBOARD_PASSWORD=

# AI gateway (module 12 §3) — empty key = sandbox (deterministic results, ai_call status 'sandbox')
ANTHROPIC_API_KEY=
# default claude-opus-5-5; daily budget per tenant in USD (default 20)
AI_MODEL=
AI_DAILY_USD=
