{
  "name": "@mmc/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, SQL migrations (incl. row-level security), tenant-scoped transactions, seed and legacy import.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "import:legacy": "tsx src/import-legacy.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mmc/domain": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "dotenv": "^17.2.3"
  }
}
